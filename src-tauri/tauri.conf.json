{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeerDav",
  "version": "0.1.0",
  "identifier": "ai.aidyou.peerdav",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PeerDav",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PeerDav",
    "license": "Proprietary",
    "category": "Utility",
    "shortDescription": "LAN WebDAV file sharing tool",
    "longDescription": "PeerDav is a desktop WebDAV server for local area networks. It shares selected folders over WebDAV, manages authorized users and access codes, filters clients by IP, subnet and MAC address, discovers peers with UDP broadcast, and keeps secret hashes encrypted in a Stronghold vault.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
