{
  "$comment": "构建矩阵唯一来源：build.yml（手动）与 release.yml（打 tag）都从这里解析，保证两条流水线平台完全一致。group 用于手动触发的平台筛选，arch 用于架构筛选。",
  "entries": [
    {
      "name": "windows-x86_64",
      "group": "windows",
      "arch": "x86_64",
      "os": "windows-latest",
      "target": "x86_64-pc-windows-msvc",
      "bundles": "nsis",
      "artifact_paths": "src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis/*.exe"
    },
    {
      "name": "windows-arm64",
      "group": "windows",
      "arch": "arm64",
      "os": "windows-11-arm",
      "target": "aarch64-pc-windows-msvc",
      "bundles": "nsis",
      "artifact_paths": "src-tauri/target/aarch64-pc-windows-msvc/release/bundle/nsis/*.exe"
    },
    {
      "name": "linux-x86_64",
      "group": "linux",
      "arch": "x86_64",
      "os": "ubuntu-22.04",
      "target": "x86_64-unknown-linux-gnu",
      "bundles": "deb,rpm,appimage",
      "artifact_paths": "src-tauri/target/x86_64-unknown-linux-gnu/release/bundle/deb/*.deb\nsrc-tauri/target/x86_64-unknown-linux-gnu/release/bundle/rpm/*.rpm\nsrc-tauri/target/x86_64-unknown-linux-gnu/release/bundle/appimage/*.AppImage"
    },
    {
      "name": "linux-arm64",
      "group": "linux",
      "arch": "arm64",
      "os": "ubuntu-22.04-arm",
      "target": "aarch64-unknown-linux-gnu",
      "bundles": "deb,rpm,appimage",
      "artifact_paths": "src-tauri/target/aarch64-unknown-linux-gnu/release/bundle/deb/*.deb\nsrc-tauri/target/aarch64-unknown-linux-gnu/release/bundle/rpm/*.rpm\nsrc-tauri/target/aarch64-unknown-linux-gnu/release/bundle/appimage/*.AppImage"
    },
    {
      "name": "macos-x86_64",
      "group": "macos",
      "arch": "x86_64",
      "os": "macos-15-intel",
      "target": "x86_64-apple-darwin",
      "bundles": "dmg",
      "artifact_paths": "src-tauri/target/x86_64-apple-darwin/release/bundle/dmg/*.dmg"
    },
    {
      "name": "macos-arm64",
      "group": "macos",
      "arch": "arm64",
      "os": "macos-15",
      "target": "aarch64-apple-darwin",
      "bundles": "dmg",
      "artifact_paths": "src-tauri/target/aarch64-apple-darwin/release/bundle/dmg/*.dmg"
    }
  ]
}
